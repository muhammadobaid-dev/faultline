<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Sawarri.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Sawarri.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Sawarri.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Sawarri.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
    </style>

    <style name="TextAppearance.Sawarri.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.Sawarri.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="TextAppearance.Sawarri.SectionHeader" parent="TextAppearance.Sawarri.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Sawarri.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="elevation">@dimen/elevation_button</item>
    </style>

    <style name="Widget.Sawarri.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/primary_light</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.Sawarri.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/error</item>
        <item name="android:textColor">@color/error</item>
    </style>

    <style name="Widget.Sawarri.Button.Small" parent="Widget.Sawarri.Button.Primary">
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.Sawarri.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/input_stroke_selector</item>
        <item name="hintTextColor">@color/text_hint</item>
    </style>

    <!-- Cards -->
    <style name="Widget.Sawarri.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.Sawarri.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

</resources>
